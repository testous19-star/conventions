{
  "name": "agreement-office-manager",
  "productName": "Agreement Office Manager",
  "version": "2.0.0",
  "description": "نظام إدارة مكتب الاتفاقيات — ديوان المركب المتعدد الرياضات (موسم 2026/2027)",
  "main": "dist/main/index.js",
  "type": "commonjs",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "dev:renderer": "vite --config vite.config.ts",
    "build:renderer": "vite build --config vite.config.ts",
    "build:main": "node tools/build-main.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "dev": "npm run build:main && cross-env VITE_DEV=1 electron .",
    "dist": "npm run build && electron-builder --win nsis portable --x64",
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}